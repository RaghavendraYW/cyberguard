# =================================================================
# CyberGuard Enterprise v2.0 — Environment Configuration
# =================================================================

# Security (Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-this-with-a-64-char-random-string
DEBUG=false

# -----------------------------------------------------------------
# Database Options
# -----------------------------------------------------------------
# Option A: Local SQLite (Default - Free, no setup, files saved locally)
DATABASE_URL=sqlite:///cyberguard.db

# Option B: Cloud PostgreSQL (Recommended for production)
# 100% Free Tiers with NO charges:
#   - Neon (neon.tech) -> Free 0.5 GB serverless PostgreSQL (no credit card needed)
#   - Supabase (supabase.com) -> Free 500MB PostgreSQL
# Example format:
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/cyberguard?sslmode=require
# Note: To migrate your existing SQLite data to PostgreSQL without losing data, run:
#   python backend/migrate_to_postgres.py --target "<YOUR_POSTGRES_URL>"

# -----------------------------------------------------------------
# Network & VPN / Zero-Trust Perimeter Configuration
# -----------------------------------------------------------------
VPN_ENABLED=true
VPN_GATEWAY_HOST=vpn.cyberguard.internal
VPN_GATEWAY_PORT=51820
VPN_SUBNET=10.8.0.0/24
VPN_KILLSWITCH_ENFORCED=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Authentication & Sessions
JWT_EXPIRE_HOURS=2
JWT_REFRESH_DAYS=30
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8

# SMTP (optional — for email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@cyberguard.io

# Webhooks (optional — Slack/Teams/PagerDuty)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_INGEST=60/minute
RATE_LIMIT_DEFAULT=200/minute

# Server
HOST=0.0.0.0
PORT=8000
